{
  "name": "infoguard-gmail-extension",
  "version": "0.1.0",
  "private": true,
  "description": "InfoGuard for Gmail - Chrome extension (Manifest V3, TypeScript)",
  "scripts": {
    "typecheck": "tsc --noEmit",
